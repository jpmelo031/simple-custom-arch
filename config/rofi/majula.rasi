* {
    background: #0E1114;
    surface: #171C20;
    elevated: #20272C;
    border: #465056;
    text: #DDD6C6;
    muted: #A39B8C;
    accent: #D1A35C;
    ember: #E0783E;
    info: #7899A2;
    success: #87996D;
    danger: #C06452;

    background-color: transparent;
    text-color: @text;
    font: "Noto Sans 11";
}

window {
    location: center;
    anchor: center;
    width: 560px;
    border: 2px;
    border-color: @ember;
    border-radius: 8px;
    background-color: @background;
}

mainbox {
    padding: 12px;
    spacing: 8px;
    background-color: @elevated;
    children: [ inputbar, mode-switcher, message, listview ];
}

inputbar {
    padding: 8px;
    spacing: 8px;
    border: 1px;
    border-color: @border;
    border-radius: 5px;
    background-color: @surface;
    text-color: @text;
    children: [ prompt, entry, case-indicator ];
}

prompt {
    padding: 2px 8px;
    border-radius: 3px;
    background-color: @accent;
    text-color: @background;
}

entry {
    placeholder: "Type to filter";
    placeholder-color: @muted;
    background-color: @surface;
    text-color: @text;
}

case-indicator {
    text-color: @muted;
}

mode-switcher {
    spacing: 4px;
    background-color: @elevated;
}

button {
    padding: 6px 8px;
    border-radius: 4px;
    background-color: @surface;
    text-color: @muted;
}

button selected {
    background-color: @accent;
    text-color: @background;
}

message {
    padding: 8px;
    border-radius: 4px;
    background-color: @surface;
}

textbox {
    background-color: @surface;
    text-color: @muted;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    scrollbar: true;
    background-color: @elevated;
}

scrollbar {
    width: 4px;
    handle-color: @border;
    background-color: @surface;
}

element {
    padding: 7px;
    spacing: 10px;
    border-radius: 5px;
    background-color: @elevated;
    text-color: @text;
}

element alternate.normal {
    background-color: @surface;
}

element selected.normal,
element selected.active {
    background-color: @accent;
    text-color: @background;
}

element normal.urgent,
element selected.urgent {
    background-color: @danger;
    text-color: @text;
}

element-icon {
    size: 22px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
