[global]
    monitor = 0
    follow = mouse
    width = 340
    height = 120
    origin = top-right
    offset = (12, 40)
    notification_limit = 5
    frame_width = 1
    frame_color = "#465056"
    separator_color = frame
    font = Noto Sans 10
    line_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8
    corner_radius = 6
    background = "#20272C"
    foreground = "#DDD6C6"
    highlight = "#D1A35C"
    timeout = 6
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#171C20"
    foreground = "#A39B8C"
    frame_color = "#7899A2"
    timeout = 4

[urgency_normal]
    background = "#20272C"
    foreground = "#DDD6C6"
    frame_color = "#87996D"
    timeout = 6

[urgency_critical]
    background = "#0E1114"
    foreground = "#DDD6C6"
    frame_color = "#C06452"
    highlight = "#E0783E"
    timeout = 0
