#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s --dry-run|--apply\n' "${0##*/}" >&2
}

if [[ $# -ne 1 || ( "$1" != --dry-run && "$1" != --apply ) ]]; then
  usage
  exit 2
fi

mode=$1
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
target_home=${SCA_HOME:-$HOME}
state_home=${SCA_STATE_HOME:-${XDG_STATE_HOME:-$target_home/.local/state}}
hyprland_config="$target_home/.config/hypr/hyprland.lua"
hyprland_import='require("majula")'
wallpaper_source="$project_root/config/hypr/assets/majula-wallpaper.svg"
wallpaper_destination="$target_home/.local/share/simple-custom-arch/majula-wallpaper.png"
backup_dir=''
rendered_wallpaper=''

cleanup() {
  if [[ -n "$rendered_wallpaper" ]]; then
    rm -f -- "$rendered_wallpaper"
  fi
}
trap cleanup EXIT

fail() {
  printf '[FAIL] %s\n' "$*" >&2
  exit 1
}

report() {
  printf '[%s] %s\n' "$1" "$2"
}

required_commands=(cmp cp date install ln mktemp readlink rg rsvg-convert)
for command_name in "${required_commands[@]}"; do
  command -v -- "$command_name" >/dev/null 2>&1 || fail "missing command: $command_name"
done

links=(
  'config/hypr/majula.lua|.config/hypr/majula.lua'
  'config/hypr/hypridle.conf|.config/hypr/hypridle.conf'
  'config/hypr/hyprlock.conf|.config/hypr/hyprlock.conf'
  'config/hypr/hyprpaper.conf|.config/hypr/hyprpaper.conf'
  'config/environment.d/90-simple-custom-arch-theme.conf|.config/environment.d/90-simple-custom-arch-theme.conf'
  'config/gtk-3.0/settings.ini|.config/gtk-3.0/settings.ini'
  'config/gtk-3.0/gtk.css|.config/gtk-3.0/gtk.css'
  'config/gtk-4.0/settings.ini|.config/gtk-4.0/settings.ini'
  'config/gtk-4.0/gtk.css|.config/gtk-4.0/gtk.css'
  'config/icons/hicolor/index.theme|.local/share/icons/hicolor/index.theme'
  'config/icons/hicolor/22x22/apps/nm-signal-100.svg|.local/share/icons/hicolor/22x22/apps/nm-signal-100.svg'
  'config/kde/kdeglobals|.config/kdeglobals'
  'config/kde/Majula.colors|.local/share/color-schemes/Majula.colors'
  'config/waybar/config.jsonc|.config/waybar/config.jsonc'
  'config/waybar/style.css|.config/waybar/style.css'
  'config/rofi/config.rasi|.config/rofi/config.rasi'
  'config/rofi/majula.rasi|.config/rofi/majula.rasi'
  'config/kitty/kitty.conf|.config/kitty/kitty.conf'
  'config/dunst/dunstrc|.config/dunst/dunstrc'
  'config/vscode/settings.json|.config/Code/User/settings.json'
  'scripts/session/clipboard-menu|.local/bin/simple-custom-arch-clipboard-menu'
  'scripts/session/session-menu|.local/bin/simple-custom-arch-session-menu'
  'scripts/session/screenshot|.local/bin/simple-custom-arch-screenshot'
  'scripts/apply-theme|.local/bin/simple-custom-arch-apply-theme'
  'systemd/user/simple-custom-arch-session.target|.config/systemd/user/simple-custom-arch-session.target'
  'systemd/user/simple-custom-arch-waybar.service|.config/systemd/user/simple-custom-arch-waybar.service'
  'systemd/user/simple-custom-arch-hyprpaper.service|.config/systemd/user/simple-custom-arch-hyprpaper.service'
  'systemd/user/simple-custom-arch-hypridle.service|.config/systemd/user/simple-custom-arch-hypridle.service'
  'systemd/user/simple-custom-arch-cliphist.service|.config/systemd/user/simple-custom-arch-cliphist.service'
)

for mapping in "${links[@]}"; do
  source_path="$project_root/${mapping%%|*}"
  destination="$target_home/${mapping#*|}"
  [[ -f "$source_path" ]] || fail "missing project source: ${mapping%%|*}"

  if [[ -L "$destination" ]]; then
    if [[ ! -e "$destination" ]]; then
      fail "broken destination link: $destination"
    fi
    source_real="$(readlink -f -- "$source_path")"
    destination_real="$(readlink -f -- "$destination")"
    [[ "$source_real" == "$destination_real" ]] || fail "conflicting destination link: $destination"
  elif [[ -e "$destination" ]]; then
    fail "conflicting destination: $destination"
  fi
done

if [[ -e "$hyprland_config" && ! -f "$hyprland_config" ]]; then
  fail "Hyprland configuration is not a regular file: $hyprland_config"
fi

if [[ "$mode" == --apply ]]; then
  rendered_wallpaper="$(mktemp "${TMPDIR:-/tmp}/simple-custom-arch-wallpaper.XXXXXX.png")"
  rsvg-convert -w 1366 -h 768 -o "$rendered_wallpaper" "$wallpaper_source"
  if [[ -e "$wallpaper_destination" && ! -f "$wallpaper_destination" ]]; then
    fail "wallpaper destination is not a regular file: $wallpaper_destination"
  fi
  if [[ -f "$wallpaper_destination" ]] && ! cmp -s -- "$rendered_wallpaper" "$wallpaper_destination"; then
    fail "conflicting wallpaper destination: $wallpaper_destination"
  fi
elif [[ -e "$wallpaper_destination" && ! -f "$wallpaper_destination" ]]; then
  fail "wallpaper destination is not a regular file: $wallpaper_destination"
fi

needs_import=1
if [[ -f "$hyprland_config" ]] && rg -Fqx -- "$hyprland_import" "$hyprland_config"; then
  needs_import=0
fi

ensure_backup_dir() {
  if [[ -z "$backup_dir" ]]; then
    backup_dir="$state_home/simple-custom-arch/backups/$(date -u +%Y%m%dT%H%M%SZ)"
    install -d -m 0700 -- "$backup_dir"
  fi
}

backup_file() {
  local path=$1
  local relative=${path#"$target_home"/}
  ensure_backup_dir
  install -D -m 0600 -- "$path" "$backup_dir/$relative"
  report BACKUP "$path -> $backup_dir/$relative"
}

if ((needs_import)); then
  if [[ "$mode" == --dry-run ]]; then
    report PLAN "append $hyprland_import to $hyprland_config"
  else
    install -d -m 0755 -- "$(dirname -- "$hyprland_config")"
    if [[ -f "$hyprland_config" ]]; then
      backup_file "$hyprland_config"
      printf '\n%s\n' "$hyprland_import" >> "$hyprland_config"
    else
      printf '%s\n' "$hyprland_import" > "$hyprland_config"
    fi
    report APPLY "added Majula import to $hyprland_config"
  fi
else
  report OK "Majula import already present in $hyprland_config"
fi

for mapping in "${links[@]}"; do
  relative_source=${mapping%%|*}
  relative_destination=${mapping#*|}
  source_path="$project_root/$relative_source"
  destination="$target_home/$relative_destination"

  if [[ -L "$destination" ]]; then
    report OK "$destination"
  elif [[ "$mode" == --dry-run ]]; then
    report PLAN "link $destination -> $source_path"
  else
    install -d -m 0755 -- "$(dirname -- "$destination")"
    ln -s -- "$source_path" "$destination"
    report APPLY "linked $destination -> $source_path"
  fi
done

if [[ -f "$wallpaper_destination" ]]; then
  report OK "$wallpaper_destination"
elif [[ "$mode" == --dry-run ]]; then
  report PLAN "render $wallpaper_destination from $wallpaper_source"
else
  install -D -m 0644 -- "$rendered_wallpaper" "$wallpaper_destination"
  report APPLY "rendered $wallpaper_destination"
fi

if [[ -n "$backup_dir" ]]; then
  report BACKUP "recovery directory: $backup_dir"
fi

report PASS "desktop deployment $mode completed"
