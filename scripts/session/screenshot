#!/usr/bin/env bash

set -euo pipefail

mode=${1:-area}
pictures_dir="$(xdg-user-dir PICTURES 2>/dev/null || true)"
if [[ -z "$pictures_dir" ]]; then
  pictures_dir="$HOME/Pictures"
fi

install -d -m 0755 -- "$pictures_dir/Screenshots"
destination="$pictures_dir/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png"

case "$mode" in
  area)
    geometry="$(slurp)" || exit 0
    [[ -n "$geometry" ]] || exit 0
    grim -g "$geometry" "$destination"
    ;;
  full)
    grim "$destination"
    ;;
  *)
    printf 'Usage: %s area|full\n' "${0##*/}" >&2
    exit 2
    ;;
esac

wl-copy --type image/png < "$destination"
printf 'Saved screenshot: %s\n' "$destination"
