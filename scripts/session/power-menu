#!/usr/bin/env bash

set -euo pipefail

confirm_action() {
  local action=$1
  local confirmation

  confirmation="$(printf 'No\nYes\n' | rofi -dmenu -i -p "$action?")" || return 1
  [[ "$confirmation" == Yes ]]
}

choice="$(printf 'Shut Down\nRestart\nCancel\n' | rofi -dmenu -i -p 'Power')" || exit 0

case "$choice" in
  'Shut Down')
    if confirm_action 'Shut Down'; then
      systemctl poweroff
    fi
    ;;
  Restart)
    if confirm_action 'Restart'; then
      systemctl reboot
    fi
    ;;
  Cancel|'')
    ;;
esac
