#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s --dry-run|--apply\n' "${0##*/}" >&2
}

if [[ $# -ne 1 || ( "$1" != --dry-run && "$1" != --apply ) ]]; then
  usage
  exit 2
fi

mode=$1
state_home=${SCA_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}
declare -a schemas=()
declare -a keys=()
declare -a desired_values=()
declare -a current_values=()
declare -a changed_indexes=()
declare -a applied_indexes=()

fail() {
  printf '[FAIL] %s\n' "$*" >&2
  exit 1
}

report() {
  printf '[%s] %s\n' "$1" "$2"
}

command -v gsettings >/dev/null 2>&1 || fail 'missing command: gsettings'

settings=(
  "org.gnome.desktop.interface|color-scheme|'prefer-dark'"
  "org.gnome.desktop.interface|gtk-theme|'Adwaita'"
  "org.gnome.desktop.interface|icon-theme|'breeze-dark'"
  "org.gnome.desktop.interface|cursor-theme|'Adwaita'"
  "org.gnome.desktop.interface|cursor-size|24"
)

for setting in "${settings[@]}"; do
  IFS='|' read -r schema key desired_value <<< "$setting"
  current_value="$(gsettings get "$schema" "$key")" ||
    fail "cannot read setting: $schema $key"
  index=${#schemas[@]}
  schemas+=("$schema")
  keys+=("$key")
  desired_values+=("$desired_value")
  current_values+=("$current_value")
  if [[ "$current_value" == "$desired_value" ]]; then
    report OK "$schema $key = $desired_value"
  else
    changed_indexes+=("$index")
    report PLAN "$schema $key: $current_value -> $desired_value"
  fi
done

if ((${#changed_indexes[@]} == 0)); then
  report PASS 'desktop theme settings already applied'
  exit 0
fi

if [[ "$mode" == --dry-run ]]; then
  report PASS 'desktop theme settings --dry-run completed'
  exit 0
fi

backup_dir="$state_home/simple-custom-arch/backups/$(date -u +%Y%m%dT%H%M%SZ)/theme"
install -d -m 0700 -- "$backup_dir"
for index in "${changed_indexes[@]}"; do
  printf '%s\t%s\n' "${keys[$index]}" "${current_values[$index]}" \
    >> "$backup_dir/gsettings.tsv"
done
chmod 0600 "$backup_dir/gsettings.tsv"
report BACKUP "desktop settings -> $backup_dir/gsettings.tsv"

rollback() {
  local status=$?
  if ((status != 0 && ${#applied_indexes[@]} > 0)); then
    set +e
    for ((position=${#applied_indexes[@]} - 1; position >= 0; position--)); do
      index=${applied_indexes[$position]}
      gsettings set "${schemas[$index]}" "${keys[$index]}" "${current_values[$index]}"
    done
    report ROLLBACK 'restored previous desktop settings'
  fi
  exit "$status"
}
trap rollback EXIT

for index in "${changed_indexes[@]}"; do
  gsettings set "${schemas[$index]}" "${keys[$index]}" "${desired_values[$index]}" ||
    fail "cannot set: ${schemas[$index]} ${keys[$index]}"
  applied_indexes+=("$index")
  actual_value="$(gsettings get "${schemas[$index]}" "${keys[$index]}")" ||
    fail "cannot verify: ${schemas[$index]} ${keys[$index]}"
  [[ "$actual_value" == "${desired_values[$index]}" ]] ||
    fail "setting did not persist: ${schemas[$index]} ${keys[$index]}"
  report APPLY "${schemas[$index]} ${keys[$index]} = ${desired_values[$index]}"
done

trap - EXIT
report PASS 'desktop theme settings --apply completed'
