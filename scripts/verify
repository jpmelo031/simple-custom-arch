#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s [--root PATH]\n' "$(basename -- "$0")" >&2
}

case "$#" in
  0)
    live_mode=1
    root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
    ;;
  2)
    if [[ "$1" != "--root" ]]; then
      usage
      exit 2
    fi
    if [[ ! -d "$2" ]]; then
      printf '[FAIL] repository root: directory does not exist: %s\n' "$2" >&2
      exit 1
    fi
    live_mode=0
    root="$(cd -- "$2" && pwd)"
    ;;
  *)
    usage
    exit 2
    ;;
esac

failures=0
rendered_preview=""
system_snapshot=""

cleanup() {
  if [[ -n "$rendered_preview" ]]; then
    rm -f -- "$rendered_preview"
  fi
  if [[ -n "$system_snapshot" ]]; then
    rm -rf -- "$system_snapshot"
  fi
}
trap cleanup EXIT

pass() {
  printf '[PASS] %s\n' "$1"
}

fail() {
  local name="$1"
  local reason="$2"
  printf '[FAIL] %s: %s\n' "$name" "$reason" >&2
  failures=$((failures + 1))
}

has_command() {
  command -v -- "$1" >/dev/null 2>&1
}

dependencies=(rg xmllint rsvg-convert file sort git)
for dependency in "${dependencies[@]}"; do
  if has_command "$dependency"; then
    pass "dependency: $dependency"
  else
    fail "dependency: $dependency" "command is not available"
  fi
done

required_files=(
  AGENTS.md
  README.md
  ROADMAP.md
  config/README.md
  config/dunst/dunstrc
  config/environment.d/90-simple-custom-arch-theme.conf
  config/gtk-3.0/gtk.css
  config/gtk-3.0/settings.ini
  config/gtk-4.0/gtk.css
  config/gtk-4.0/settings.ini
  config/hypr/assets/majula-wallpaper.svg
  config/hypr/hypridle.conf
  config/hypr/hyprlock.conf
  config/hypr/hyprpaper.conf
  config/hypr/majula.lua
  config/icons/hicolor/index.theme
  config/icons/hicolor/22x22/apps/nm-signal-100.svg
  config/kde/kdeglobals
  config/kde/Majula.colors
  config/kitty/kitty.conf
  config/rofi/config.rasi
  config/rofi/majula.rasi
  config/vscode/settings.json
  config/waybar/config.jsonc
  config/waybar/style.css
  docs/assets/theme-preview.svg
  docs/baseline/README.md
  docs/baseline/foreign-explicit.txt
  docs/baseline/hardware.md
  docs/baseline/official-explicit.txt
  docs/baseline/services.md
  docs/maintenance.md
  docs/superpowers/plans/2026-10-08-phase-1-base-system.md
  docs/superpowers/plans/2026-10-09-additive-desktop-configuration.md
  docs/superpowers/specs/2026-10-08-phase-1-base-system-design.md
  docs/superpowers/specs/2026-10-09-additive-desktop-configuration-design.md
  docs/theme.md
  packages/README.md
  packages/aur.txt
  packages/official.txt
  scripts/README.md
  scripts/install-desktop
  scripts/apply-theme
  scripts/lib/phase1-verify.sh
  scripts/verify
  tests/phase0-verify.sh
  tests/desktop-config.sh
  tests/apply-theme.sh
  tests/install-desktop.sh
  tests/phase1-manifests.sh
  tests/phase1-verify.sh
  tests/verify.sh
)

for relative_path in "${required_files[@]}"; do
  if [[ -f "$root/$relative_path" ]]; then
    pass "required file: $relative_path"
  else
    fail "required file: $relative_path" "missing $relative_path"
  fi
done

required_directories=(
  config/dunst
  config/environment.d
  config/gtk-3.0
  config/gtk-4.0
  config/hypr
  config/icons
  config/kde
  config/kitty
  config/rofi
  config/vscode
  config/waybar
  scripts/lib
  systemd/user
)

for relative_path in "${required_directories[@]}"; do
  if [[ -d "$root/$relative_path" ]]; then
    pass "reserved directory: $relative_path"
  else
    fail "reserved directory: $relative_path" "directory is missing"
  fi
done

check_package_snapshot() {
  local relative_path="$1"
  local snapshot="$root/$relative_path"

  if [[ ! -f "$snapshot" ]]; then
    fail "package snapshot: $relative_path" "file is missing"
    return
  fi

  if ! has_command sort; then
    fail "package snapshot: $relative_path" "ordering check requires sort"
    return
  fi

  if LC_ALL=C sort -c -u -- "$snapshot" >/dev/null 2>&1; then
    pass "package snapshot: $relative_path is sorted and unique"
  else
    fail "package snapshot: $relative_path" "entries are not sorted and unique"
  fi
}

check_package_snapshot docs/baseline/official-explicit.txt
check_package_snapshot docs/baseline/foreign-explicit.txt

baseline_directory="$root/docs/baseline"
sensitive_pattern='(/home/[^/[:space:]]+|/root/|UUID=|PARTUUID=|[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}|([0-9]{1,3}\.){3}[0-9]{1,3}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})'

if [[ ! -d "$baseline_directory" ]]; then
  fail "baseline sensitive data" "docs/baseline is missing"
elif ! has_command rg; then
  fail "baseline sensitive data" "scan requires rg"
else
  sensitive_reason=""

  if rg -n -- "$sensitive_pattern" "$baseline_directory" >/dev/null 2>&1; then
    sensitive_reason="a prohibited path, identifier, address, or credential pattern was found"
  fi

  if ((live_mode)); then
    current_user="$(id -un 2>/dev/null || true)"
    if [[ -n "$current_user" ]] \
      && rg -F -n -- "$current_user" "$baseline_directory" >/dev/null 2>&1; then
      sensitive_reason="the current user name was found"
    fi

    current_hostname="$(hostnamectl --static 2>/dev/null || true)"
    if [[ -z "$current_hostname" && -r /etc/hostname ]]; then
      IFS= read -r current_hostname < /etc/hostname || true
    fi
    if [[ -n "$current_hostname" ]] \
      && rg -F -n -- "$current_hostname" "$baseline_directory" >/dev/null 2>&1; then
      sensitive_reason="the current hostname was found"
    fi
  fi

  if [[ -z "$sensitive_reason" ]]; then
    pass "baseline sensitive data scan"
  else
    fail "baseline sensitive data" "$sensitive_reason"
  fi
fi

preview="$root/docs/assets/theme-preview.svg"
theme_reference="$root/docs/theme.md"

if [[ ! -f "$preview" ]]; then
  fail "theme preview XML" "docs/assets/theme-preview.svg is missing"
elif ! has_command xmllint; then
  fail "theme preview XML" "validation requires xmllint"
elif xmllint --noout "$preview" >/dev/null 2>&1; then
  pass "theme preview XML"
else
  fail "theme preview XML" "theme preview is not well-formed XML"
fi

if [[ ! -f "$preview" ]]; then
  fail "theme preview viewBox" "docs/assets/theme-preview.svg is missing"
elif ! has_command rg; then
  fail "theme preview viewBox" "validation requires rg"
elif rg -q 'viewBox="0 0 1366 768"' -- "$preview"; then
  pass "theme preview viewBox"
else
  fail "theme preview viewBox" "expected viewBox=\"0 0 1366 768\""
fi

palette=(
  '#0E1114'
  '#171C20'
  '#20272C'
  '#465056'
  '#7899A2'
  '#87996D'
  '#A39B8C'
  '#C06452'
  '#D1A35C'
  '#DDD6C6'
  '#E0783E'
)

for color in "${palette[@]}"; do
  if [[ ! -f "$theme_reference" || ! -f "$preview" ]]; then
    fail "palette: $color" "theme reference or preview is missing"
  elif ! has_command rg; then
    fail "palette: $color" "validation requires rg"
  elif rg -F -q -- "$color" "$theme_reference" \
    && rg -F -q -- "$color" "$preview"; then
    pass "palette: $color appears in the theme reference and preview"
  else
    fail "palette: $color" "value is missing from the theme reference or preview"
  fi
done

if [[ ! -f "$preview" ]]; then
  fail "theme preview render" "docs/assets/theme-preview.svg is missing"
elif ! has_command rsvg-convert || ! has_command file || ! has_command rg; then
  fail "theme preview render" "validation requires rsvg-convert, file, and rg"
else
  rendered_preview="$(mktemp "${TMPDIR:-/tmp}/simple-custom-arch-preview.XXXXXX.png")"
  if rsvg-convert -w 1366 -h 768 -o "$rendered_preview" "$preview" >/dev/null 2>&1 \
    && file -- "$rendered_preview" | rg -q '1366 x 768'; then
    pass "theme preview renders at 1366 x 768"
  else
    fail "theme preview render" "theme preview did not render as a 1366 x 768 PNG"
  fi
fi

if [[ -e "$root/.git" ]]; then
  if ! has_command git; then
    fail "Git whitespace check" "validation requires git"
  elif git -C "$root" diff --check; then
    pass "Git whitespace check"
  else
    fail "Git whitespace check" "git diff --check reported an error"
  fi
else
  pass "Git whitespace check skipped for fixture without .git"
fi

phase1_library="$root/scripts/lib/phase1-verify.sh"
if [[ -f "$phase1_library" ]]; then
  # shellcheck source=lib/phase1-verify.sh
  source "$phase1_library"
  phase1_verify_repository "$root"

  if ((live_mode)); then
    system_snapshot="$(mktemp -d "${TMPDIR:-/tmp}/simple-custom-arch-phase1-live.XXXXXX")"
    phase1_capture_system "$system_snapshot"
    phase1_verify_system "$root" "$system_snapshot"
  fi
else
  fail "Phase 1 verifier" "missing scripts/lib/phase1-verify.sh"
fi

if ((failures > 0)); then
  printf '[FAIL] complete verification: %d check(s) failed\n' "$failures" >&2
  exit 1
fi

pass "complete verification"
